# Dependencies (rebuilt inside the container)
node_modules
.pnp
.pnp.*
.yarn

# Next.js build output
.next
out
build

# Env files — never bake secrets into the image.
# Runtime env is provided via docker-compose env_file (.env).
.env
.env.*
!.env.example

# Git / VCS
.git
.gitignore
.gitattributes

# IDE / editor
.vscode
.idea
*.swp
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Tests / coverage
coverage

# Docker meta
Dockerfile
docker-compose.yml
.dockerignore

# Docs / agent files (not needed at runtime)
docs
README.md
CLAUDE.md
AGENTS.md
NextBoard_Prompt_cho_coding_agent.txt

# Misc
*.pem
certificates
.vercel
*.tsbuildinfo
next-env.d.ts
